# Cloudflare Pages security headers
# These are applied to every response served from this site.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https://docs.google.com https://*.googleusercontent.com; manifest-src 'self'; upgrade-insecure-requests

# Note: no per-page overrides. Cloudflare Pages serves clean URLs (/qr, not
# /qr.html) and rules here are ADDITIVE — a second Content-Security-Policy
# header makes browsers enforce the intersection of both, so a "relaxed"
# scoped policy can never loosen the global one. The QR generator therefore
# self-hosts its script/styles (js/vendor, css/qr.css) and runs under the
# same strict policy as every other page.
